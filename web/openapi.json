{
  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "integer"
          }
        },
        "required": [
          "action"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "BatchActionRequest": {
        "properties": {
          "action_ids": {
            "description": "Actions applied in order, all or nothing.",
            "items": {
              "type": "integer"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Action Ids",
            "type": "array"
          }
        },
        "required": [
          "action_ids"
        ],
        "title": "BatchActionRequest",
        "type": "object"
      },
      "CreateGameRequest": {
        "properties": {
          "game": {
            "default": "lignum",
            "title": "Game",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/GameParams"
          },
          "scenario": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional scenario JSON (docs/SCENARIOS.md); the game starts from it.",
            "title": "Scenario"
          },
          "seats": {
            "items": {
              "description": "human or a bot seat type (random, heuristic, heuristic-v1, heuristic-v2, heuristic-v3, heuristic-v4, heuristic-v5, heuristic-v6, heuristic-v7, strategist, az, mcts, mcts-fast).",
              "pattern": "^(human|random|heuristic|heuristic-v1|heuristic-v2|heuristic-v3|heuristic-v4|heuristic-v5|heuristic-v6|heuristic-v7|strategist|az|azpp|mcts|mcts-fast)$",
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "required": [
          "seats"
        ],
        "title": "CreateGameRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameExport": {
        "description": "Replay file: everything needed to rebuild a game by replaying `history`.",
        "properties": {
          "game": {
            "title": "Game",
            "type": "string"
          },
          "history": {
            "items": {
              "type": "integer"
            },
            "title": "History",
            "type": "array"
          },
          "params": {
            "$ref": "#/components/schemas/GameParams"
          },
          "scenario": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scenario the game started from, if any.",
            "title": "Scenario"
          },
          "seats": {
            "items": {
              "description": "human or a bot seat type (random, heuristic, heuristic-v1, heuristic-v2, heuristic-v3, heuristic-v4, heuristic-v5, heuristic-v6, heuristic-v7, strategist, az, mcts, mcts-fast).",
              "pattern": "^(human|random|heuristic|heuristic-v1|heuristic-v2|heuristic-v3|heuristic-v4|heuristic-v5|heuristic-v6|heuristic-v7|strategist|az|azpp|mcts|mcts-fast)$",
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          }
        },
        "required": [
          "game",
          "params",
          "seats",
          "history"
        ],
        "title": "GameExport",
        "type": "object"
      },
      "GameParams": {
        "additionalProperties": true,
        "description": "Creation parameters for a game; adapters read the fields they know (extras are kept).",
        "properties": {
          "joinery": {
            "default": true,
            "description": "Play with the Joinery and Buildings expansion.",
            "title": "Joinery",
            "type": "boolean"
          },
          "num_players": {
            "anyOf": [
              {
                "maximum": 4.0,
                "minimum": 2.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of players (2..4).",
            "title": "Num Players"
          },
          "returns": {
            "default": "win_loss",
            "description": "Terminal returns mode.",
            "enum": [
              "win_loss",
              "margin"
            ],
            "title": "Returns",
            "type": "string"
          }
        },
        "title": "GameParams",
        "type": "object"
      },
      "GameView": {
        "description": "A game as seen by one seat.",
        "properties": {
          "bot_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the bot worker failed; POST bots/retry to retry.",
            "title": "Bot Error"
          },
          "bot_thinking": {
            "description": "A bot seat is to move and has not failed (false in the error state).",
            "title": "Bot Thinking",
            "type": "boolean"
          },
          "current_player": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seat to move; null at chance or terminal.",
            "title": "Current Player"
          },
          "dev_mode": {
            "description": "Server allows dev-only operations (rewind).",
            "title": "Dev Mode",
            "type": "boolean"
          },
          "game": {
            "title": "Game",
            "type": "string"
          },
          "history": {
            "description": "Labelled action history, oldest first.",
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "title": "History",
            "type": "array"
          },
          "history_length": {
            "title": "History Length",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_terminal": {
            "title": "Is Terminal",
            "type": "boolean"
          },
          "legal_actions": {
            "description": "Actions for current_player.",
            "items": {
              "$ref": "#/components/schemas/LegalAction"
            },
            "title": "Legal Actions",
            "type": "array"
          },
          "returns": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Final returns when terminal.",
            "title": "Returns"
          },
          "seat": {
            "title": "Seat",
            "type": "integer"
          },
          "seat_types": {
            "items": {
              "description": "human or a bot seat type (random, heuristic, heuristic-v1, heuristic-v2, heuristic-v3, heuristic-v4, heuristic-v5, heuristic-v6, heuristic-v7, strategist, az, mcts, mcts-fast).",
              "pattern": "^(human|random|heuristic|heuristic-v1|heuristic-v2|heuristic-v3|heuristic-v4|heuristic-v5|heuristic-v6|heuristic-v7|strategist|az|azpp|mcts|mcts-fast)$",
              "type": "string"
            },
            "title": "Seat Types",
            "type": "array"
          },
          "seats": {
            "items": {
              "description": "human or a bot seat type (random, heuristic, heuristic-v1, heuristic-v2, heuristic-v3, heuristic-v4, heuristic-v5, heuristic-v6, heuristic-v7, strategist, az, mcts, mcts-fast).",
              "pattern": "^(human|random|heuristic|heuristic-v1|heuristic-v2|heuristic-v3|heuristic-v4|heuristic-v5|heuristic-v6|heuristic-v7|strategist|az|azpp|mcts|mcts-fast)$",
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "view": {
            "additionalProperties": true,
            "description": "Adapter-defined view payload.",
            "title": "View",
            "type": "object"
          },
          "winners": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Winning seats when terminal.",
            "title": "Winners"
          }
        },
        "required": [
          "id",
          "game",
          "seats",
          "seat_types",
          "bot_thinking",
          "seat",
          "history_length",
          "history",
          "dev_mode",
          "current_player",
          "is_terminal",
          "legal_actions",
          "view"
        ],
        "title": "GameView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryEntry": {
        "description": "One past action; `actor` is null for chance outcomes. Hidden picks have a null id.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Action id; null when hidden from the rendered seat.",
            "title": "Id"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "index",
          "actor",
          "id",
          "label"
        ],
        "title": "HistoryEntry",
        "type": "object"
      },
      "LegalAction": {
        "description": "One action the seat to move may take, as described by the adapter.",
        "properties": {
          "card": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card"
          },
          "faction": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Faction"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "region": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "LegalAction",
        "type": "object"
      },
      "ReportRequest": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. \"engine\", \"ui\", \"other\".",
            "title": "Category"
          },
          "note": {
            "description": "What went wrong (required).",
            "minLength": 1,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "note"
        ],
        "title": "ReportRequest",
        "type": "object"
      },
      "ReportResponse": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "report_id": {
            "title": "Report Id",
            "type": "string"
          }
        },
        "required": [
          "report_id",
          "path"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "RewindRequest": {
        "properties": {
          "player_actions": {
            "title": "Player Actions",
            "type": "integer"
          }
        },
        "required": [
          "player_actions"
        ],
        "title": "RewindRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Lignum server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/games": {
      "post": {
        "operationId": "create_game",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create Game"
      }
    },
    "/api/games/import": {
      "post": {
        "operationId": "import_game",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameExport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Import Game"
      }
    },
    "/api/games/{game_id}": {
      "get": {
        "operationId": "get_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          },
          {
            "description": "Playback frame: render the state after the first `at` raw history entries (the unit of `history_length` and `HistoryEntry.index`; one entry per action or chance outcome). Read-only; filtered for `seat` as the live view was at that state. Outside 0..history_length is 409; equal to it is the live view.",
            "in": "query",
            "name": "at",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Playback frame: render the state after the first `at` raw history entries (the unit of `history_length` and `HistoryEntry.index`; one entry per action or chance outcome). Read-only; filtered for `seat` as the live view was at that state. Outside 0..history_length is 409; equal to it is the live view.",
              "title": "At"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Game"
      }
    },
    "/api/games/{game_id}/actions": {
      "post": {
        "operationId": "post_action",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Action"
      }
    },
    "/api/games/{game_id}/actions/batch": {
      "post": {
        "operationId": "post_action_batch",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Action Batch"
      }
    },
    "/api/games/{game_id}/back": {
      "post": {
        "operationId": "go_back",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Go Back"
      }
    },
    "/api/games/{game_id}/bots/retry": {
      "post": {
        "operationId": "retry_bots",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          }
        ],
        "responses": {
          "200": {
